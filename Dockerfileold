# i want to create a dockerfile to install nginx and copy a file from the host to the container
FROM nginx:latest
# Copy the file from the host to the container
COPY ./nginx.conf /etc/nginx/nginx.conf
# Expose port 80
EXPOSE 80
# Start nginx
CMD ["nginx", "-g", "daemon off;"]
